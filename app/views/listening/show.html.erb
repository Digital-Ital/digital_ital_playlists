<% content_for :title, "Listening Desk | Digital Ital Crates" %>
<% content_for :head do %>
  <style>#sticky-footer { display: none !important; }</style>
<% end %>

<div class="min-h-screen bg-gradient-to-b from-gray-950 via-slate-950 to-black">
  <div class="container mx-auto max-w-7xl px-4 py-8 sm:px-6">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-green-400">Digital Ital Listening Desk</p>
      <h1 class="text-3xl font-bold text-white">Crate intelligence</h1>
      <% if @current_track.present? %>
        <p data-listening-track-id="<%= @current_track[:spotify_id] %>" class="mt-2 text-sm text-green-300">● Listening: <span class="font-semibold text-white"><%= @current_track[:name] %></span> — <%= @current_track[:artist] %></p>
      <% elsif @connected %>
        <p data-listening-track-id="" class="mt-2 text-sm text-gray-400">● Spotify is connected; waiting for the next song.</p>
      <% else %>
        <p data-listening-track-id="" class="mt-2 text-sm text-gray-400">● Connect Spotify in the owner setup to enable live listening.</p>
      <% end %>
    </div>
    <%= link_to "← Back to crates", root_path, class: "inline-flex items-center rounded-lg bg-gray-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-700" %>
  </div>

  <% if @listening_error.present? %>
    <div class="mb-6 rounded-xl border border-red-500/50 bg-red-950/40 p-4 text-red-200">
      Live Spotify data is temporarily unavailable: <%= @listening_error %>
    </div>
  <% end %>

  <% if @selected_lookup.present? %>
    <% source = @selected_lookup[:source] %>
    <% exact = @selected_lookup[:match_type] == :exact %>
    <% likely = @selected_lookup[:match_type] == :likely_duplicate %>
    <section class="mt-8 rounded-2xl border <%= exact ? 'border-green-500/40' : likely ? 'border-yellow-500/40' : 'border-gray-700' %> bg-gray-950/90 p-6 shadow-2xl">
      <div class="flex flex-col gap-6 md:flex-row">
        <% if source[:image_url].present? %>
          <img src="<%= source[:image_url] %>" alt="" class="h-40 w-40 rounded-xl object-cover shadow-xl">
        <% else %>
          <div class="flex h-40 w-40 items-center justify-center rounded-xl bg-gray-800 text-5xl">🎵</div>
        <% end %>

        <div class="min-w-0 flex-1">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <% if exact %>
              <span class="rounded-full border border-green-400/50 bg-green-500/15 px-3 py-1 text-xs font-bold text-green-300">✓ Exact track in crates</span>
            <% elsif likely %>
              <span class="rounded-full border border-yellow-400/50 bg-yellow-500/15 px-3 py-1 text-xs font-bold text-yellow-300">≈ Likely same recording / version</span>
            <% else %>
              <span class="rounded-full border border-gray-500 bg-gray-800 px-3 py-1 text-xs font-bold text-gray-300">Not currently in crates</span>
            <% end %>
          </div>
          <h2 class="text-3xl font-bold text-white"><%= source[:name] %></h2>
          <p class="mt-1 text-xl text-gray-200"><%= source[:artist] %></p>
          <% if source[:album].present? %><p class="mt-1 text-sm text-gray-400"><%= source[:album] %></p><% end %>
          <% if source[:external_url].present? %>
            <%= link_to "Open in Spotify ↗", source[:external_url], target: "_blank", rel: "noopener", class: "mt-4 inline-flex text-sm font-semibold text-green-400 hover:text-green-300" %>
          <% end %>
        </div>
      </div>

      <%= render "crate_placements", memberships: @selected_lookup[:memberships] %>

      <%= render "same_title_links", same_title_matches: @selected_lookup[:same_title_matches] %>

      <% if @dossier_track.present? %>
        <%= render "curator_summary", track: @dossier_track, enrichment: @dossier_enrichment, claims: @dossier_claims %>
        <%= render "song_dossier", track: @dossier_track %>
      <% end %>

      <% footprint_key = source[:spotify_id].presence || source[:name].to_s.parameterize.presence || "lookup" %>
      <% footprint_params = {
        spotify_id: source[:spotify_id],
        name: source[:name],
        artist: source[:artist],
        album: source[:album],
        key: footprint_key
      } %>

      <section class="mt-7">
        <div>
          <h3 class="text-xl font-bold text-white">Deeper crate footprints</h3>
          <p class="mt-1 text-sm text-gray-400">Artist and album analysis is optional and loads from your local database only when you expand it.</p>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-2">
          <details id="artist-footprint-details-<%= footprint_key %>" data-turbo-permanent data-listening-footprint class="rounded-xl border border-blue-500/20 bg-blue-950/20 p-4">
            <summary class="cursor-pointer list-none font-semibold text-blue-200 marker:hidden">
              <span class="flex items-center justify-between gap-3">
                <span>Artist footprint</span>
                <span class="text-xs text-blue-300">Expand to load</span>
              </span>
            </summary>
            <%= turbo_frame_tag "artist-footprint-#{footprint_key}", data: { footprint_src: listening_footprint_path(footprint_params.merge(scope: "artist")) } do %>
              <p class="mt-4 text-sm text-gray-400">Expand this section to load artist connections from the local crate database.</p>
            <% end %>
          </details>

          <details id="album-footprint-details-<%= footprint_key %>" data-turbo-permanent data-listening-footprint class="rounded-xl border border-purple-500/20 bg-purple-950/20 p-4">
            <summary class="cursor-pointer list-none font-semibold text-purple-200 marker:hidden">
              <span class="flex items-center justify-between gap-3">
                <span>Album footprint</span>
                <span class="text-xs text-purple-300">Expand to load</span>
              </span>
            </summary>
            <%= turbo_frame_tag "album-footprint-#{footprint_key}", data: { footprint_src: listening_footprint_path(footprint_params.merge(scope: "album")) } do %>
              <p class="mt-4 text-sm text-gray-400">Expand this section to load album connections from the local crate database.</p>
            <% end %>
          </details>
        </div>
      </section>
    </section>
  <% end %>

  <details <%= "open" if @query.present? %> class="mt-8 rounded-xl border border-gray-700 bg-gray-900/70">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-gray-200 marker:hidden">
      <span>Search another song</span>
      <span class="text-xs font-normal text-gray-400">Local crate database only</span>
    </summary>
    <div class="border-t border-gray-700 px-4 pb-4 pt-3">
      <p class="text-sm text-gray-400">Search artist, song title, or album.</p>
      <%= form_with url: listening_path, method: :get, local: true, class: "mt-3 flex flex-col gap-3 sm:flex-row" do |form| %>
        <%= form.search_field :q, value: @query, placeholder: "Artist + song title…", class: "min-w-0 flex-1 rounded-lg border border-gray-600 bg-gray-950 px-4 py-3 text-white placeholder:text-gray-500 focus:border-yellow-400 focus:outline-none" %>
        <%= form.submit "Search crates", class: "rounded-lg bg-yellow-500 px-5 py-3 font-bold text-black transition hover:bg-yellow-400" %>
      <% end %>

      <% if @query.present? %>
        <div class="mt-5">
          <p class="mb-3 text-sm text-gray-400"><%= @search_results.size %> matching song<%= "s" unless @search_results.size == 1 %> for “<%= @query %>”</p>
          <% if @search_results.any? %>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
              <% @search_results.each do |track| %>
                <%= link_to listening_path(track_id: track.id, q: @query), class: "flex items-center gap-3 rounded-xl border border-gray-700 bg-gray-950/70 p-3 transition hover:border-yellow-400/70 hover:bg-gray-800" do %>
                  <% if track.image_url.present? %>
                    <img src="<%= track.image_url %>" alt="" class="h-14 w-14 rounded object-cover">
                  <% else %>
                    <div class="flex h-14 w-14 items-center justify-center rounded bg-gray-800">🎵</div>
                  <% end %>
                  <div class="min-w-0">
                    <p class="truncate font-semibold text-white"><%= track.name %></p>
                    <p class="truncate text-sm text-gray-300"><%= track.artist %></p>
                    <p class="truncate text-xs text-gray-500"><%= track.album %></p>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="rounded-lg bg-gray-950 p-4 text-gray-400">No matching songs are in the current crate database.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </details>

  <%= render "recent_listens", recent_tracks: @recent_tracks, connected: @connected %>
  </div>
</div>

<script>
  (function() {
    function loadListeningFootprint(details) {
      const frame = details.querySelector("turbo-frame[data-footprint-src]");
      if (details.open && frame && !frame.getAttribute("src")) {
        frame.setAttribute("src", frame.dataset.footprintSrc);
      }
    }

    function loadSongDossier(details) {
      const frame = details.querySelector("turbo-frame[data-dossier-src]");
      if (details.open && frame && !frame.getAttribute("src")) {
        frame.setAttribute("src", frame.dataset.dossierSrc);
      }
    }

    function setupListeningFootprints() {
      document.querySelectorAll("[data-listening-footprint]").forEach(function(details) {
        if (details.dataset.footprintBound === "true") return;

        details.dataset.footprintBound = "true";
        details.addEventListener("toggle", function() {
          loadListeningFootprint(details);
        });
        loadListeningFootprint(details);
      });
    }

    function setupSongDossiers() {
      document.querySelectorAll("[data-song-dossier]").forEach(function(details) {
        if (details.dataset.dossierBound === "true") return;

        details.dataset.dossierBound = "true";
        details.addEventListener("toggle", function() {
          loadSongDossier(details);
        });
        loadSongDossier(details);
      });
    }

    function setupListeningDeskDetails() {
      setupListeningFootprints();
      setupSongDossiers();
    }

    document.removeEventListener("turbo:load", window.listeningFootprintsOnLoad);
    window.listeningFootprintsOnLoad = setupListeningDeskDetails;
    document.addEventListener("turbo:load", window.listeningFootprintsOnLoad);
  })();
</script>

<% if @connected && @query.blank? %>
  <script>
    (function() {
      function currentListeningTrackId() {
        return document.querySelector("[data-listening-track-id]")?.dataset.listeningTrackId || null;
      }

      function scheduleListeningDeskRefresh() {
        const previousTrackId = window.listeningDeskPreviousTrackId;
        const currentTrackId = currentListeningTrackId();
        const savedScrollY = window.listeningDeskSavedScrollY;

        delete window.listeningDeskPreviousTrackId;
        delete window.listeningDeskSavedScrollY;

        if (typeof savedScrollY === "number" && previousTrackId === currentTrackId) {
          window.requestAnimationFrame(function() {
            window.scrollTo(0, savedScrollY);
          });
        } else if (previousTrackId !== undefined && previousTrackId !== currentTrackId) {
          window.scrollTo(0, 0);
        }

        window.clearTimeout(window.listeningDeskRefreshTimer);
        window.listeningDeskRefreshTimer = window.setTimeout(function() {
          window.listeningDeskPreviousTrackId = currentListeningTrackId();
          window.listeningDeskSavedScrollY = window.scrollY;
          Turbo.visit(window.location.href, { action: "replace" });
        }, 20000);
      }

      document.removeEventListener("turbo:load", window.listeningDeskOnLoad);
      window.listeningDeskOnLoad = scheduleListeningDeskRefresh;
      document.addEventListener("turbo:load", window.listeningDeskOnLoad);
    })();
  </script>
<% end %>
