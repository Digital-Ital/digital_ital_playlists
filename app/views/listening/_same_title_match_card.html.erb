<% track = title_match[:track] %>
<% card_class = case title_match[:match_kind]
  when :exact_spotify_id then "border-emerald-500/30 bg-emerald-950/15"
  when :strong_artist_variant then "border-yellow-500/40 bg-yellow-950/15"
  else "border-green-500/30 bg-green-950/10"
end %>

<article class="rounded-xl border <%= card_class %> p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h5 class="truncate font-bold text-white"><%= track.name %></h5>
      <p class="truncate text-sm text-gray-200"><%= track.artist %></p>
      <% if track.album.present? %><p class="truncate text-xs text-gray-500"><%= track.album %></p><% end %>
    </div>
    <% case title_match[:match_kind] %>
    <% when :exact_spotify_id %>
      <span class="shrink-0 rounded-full border border-emerald-400/40 bg-emerald-500/10 px-2 py-1 text-[11px] font-semibold text-emerald-300">Same Spotify ID</span>
    <% when :strong_artist_variant %>
      <span class="shrink-0 rounded-full border border-yellow-400/40 bg-yellow-500/10 px-2 py-1 text-[11px] font-semibold text-yellow-200">Artist variation</span>
    <% else %>
      <span class="shrink-0 rounded-full border border-green-400/30 bg-green-500/10 px-2 py-1 text-[11px] font-semibold text-green-200">Different artist</span>
    <% end %>
  </div>

  <% if title_match[:match_kind] == :strong_artist_variant %>
    <div class="mt-4 rounded-lg border border-yellow-400/35 bg-yellow-950/45 p-3 text-sm text-yellow-100">
      <p class="font-bold">⚠ Strong suspected duplicate</p>
      <p class="mt-1 text-xs text-yellow-200">Same cleaned title and a related artist name, but a different Spotify ID.</p>
    </div>
  <% end %>

  <% if title_match[:exact_spotify_id] && title_match[:duplicate_playlists].any? %>
    <div class="mt-4 rounded-lg border border-red-400/50 bg-red-950/50 p-3 text-sm text-red-100">
      <p class="font-bold">⚠ Probable duplicate in this playlist</p>
      <ul class="mt-2 space-y-1 text-xs text-red-200">
        <% title_match[:duplicate_playlists].each do |duplicate| %>
          <li><%= duplicate[:playlist].title %> — positions #<%= duplicate[:positions].join(", #") %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <ul class="mt-4 space-y-2">
    <% title_match[:memberships].each do |membership| %>
      <li class="rounded-lg border border-white/10 bg-gray-900/70 p-3">
        <div class="flex items-start justify-between gap-3">
          <%= link_to membership[:playlist].title, playlist_path(membership[:playlist]), class: "min-w-0 font-semibold text-yellow-300 hover:text-yellow-200" %>
          <span class="shrink-0 text-xs text-gray-400">#<%= membership[:position].to_i + 1 %></span>
        </div>
        <% if membership[:categories].any? %>
          <div class="mt-2 flex flex-wrap gap-1">
            <% membership[:categories].each do |category| %>
              <span class="rounded-full px-2 py-0.5 text-[11px] text-white" style="background-color: <%= category.color.presence || '#4B5563' %>"><%= category.name %></span>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</article>
