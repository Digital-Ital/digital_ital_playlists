<% summary = enrichment&.curator_summary(claims) || { release_years: [], classifications: [], song_contexts: [], signals: [] } %>
<% release_years = summary.fetch(:release_years) %>
<% earliest_reliable_year = summary.fetch(:earliest_reliable_year, nil) %>
<% classifications = summary.fetch(:classifications) %>
<% song_contexts = summary.fetch(:song_contexts, []) %>
<% signals = summary.fetch(:signals) %>
<% musicbrainz_claims = Array(claims).select { |claim| claim.source == "musicbrainz" } %>
<% musicbrainz_error = enrichment&.last_error.to_s.split(" | ").find { |error| error.start_with?("MusicBrainz:") } %>
<% signal_labels = {
  "release_type" => "Release type",
  "release_format" => "Format",
  "release_position" => "Position",
  "release_track_count" => "Album tracks",
  "content_advisory" => "Advisory",
  "recording_note" => "Version note",
  "recording_location" => "Session / location",
  "work_title" => "Composition / work",
  "work_type" => "Work type",
  "work_disambiguation" => "Work note",
  "iswc" => "ISWC",
  "producer" => "Producer",
  "engineer" => "Engineer",
  "mastering_engineer" => "Mastering",
  "mixer" => "Mixer",
  "performer" => "Performer",
  "writer" => "Writer",
  "composer" => "Composer",
  "lyricist" => "Lyricist",
  "arranger" => "Arranger",
  "relationship_fact" => "Relationship"
} %>

<%= turbo_frame_tag "curator-summary-#{track.id}" do %>
  <section class="mt-7 rounded-xl border border-cyan-400/25 bg-cyan-950/15 p-5" data-curator-summary>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-300">Automatic catalogue research</p>
        <h3 class="mt-1 text-xl font-bold text-white">Source years & curator signals</h3>
        <p class="mt-1 max-w-3xl text-sm text-gray-300">Every live exact recording is looked up automatically once, then read from the local database. Years remain separate because the sources can describe different editions or recordings.</p>
      </div>
      <% if enrichment&.last_refreshed_at.present? %>
        <p class="text-xs text-gray-400" title="<%= enrichment.last_refreshed_at.strftime("%B %-d, %Y at %-l:%M %p") %>">Saved <%= time_ago_in_words(enrichment.last_refreshed_at) %> ago</p>
      <% end %>
    </div>

    <section class="mt-5 rounded-xl border border-gray-700 bg-black/25 p-4">
      <h4 class="font-semibold text-gray-100">Release years</h4>
      <p class="mt-1 text-xs text-gray-400">Spotify = its album/reissue; MusicBrainz = earliest known release; Discogs = selected pressing or an automatic candidate.</p>

      <% if earliest_reliable_year.present? %>
        <p class="mt-3 rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-100">Earliest reliable source year: <span class="font-bold"><%= earliest_reliable_year.release_year %></span> · <%= earliest_reliable_year.source_label %></p>
      <% end %>

      <% if release_years.any? %>
        <div class="mt-3 grid gap-3 md:grid-cols-3">
          <% release_years.each do |claim| %>
            <article class="rounded-lg border border-gray-800 bg-gray-950/80 p-3">
              <p class="text-xs font-semibold text-cyan-200"><%= claim.source_label %></p>
              <p class="mt-1 text-3xl font-bold text-white"><%= claim.release_year %></p>
              <p class="mt-1 text-xs <%= claim.high_confidence_match? ? "text-emerald-200" : "text-yellow-200" %>"><%= claim.confidence_label %></p>
              <p class="mt-2 text-xs text-gray-400"><%= claim.context %></p>
              <% if claim.discogs? && claim.source_url.present? %>
                <%= link_to "Data provided by Discogs.", claim.source_url, target: "_blank", rel: "noopener", class: "mt-2 inline-block text-xs font-semibold text-orange-300 hover:text-orange-200" %>
              <% elsif claim.source_url.present? %>
                <%= link_to "#{claim.source_label} ↗", claim.source_url, target: "_blank", rel: "noopener", class: "mt-2 inline-block text-xs font-semibold text-cyan-300 hover:text-cyan-200" %>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-gray-400">No source year was returned for this recording yet.</p>
      <% end %>

      <% if musicbrainz_error.present? %>
        <p class="mt-3 rounded-lg border border-yellow-500/30 bg-yellow-950/25 px-3 py-2 text-xs text-yellow-100"><span class="font-semibold">MusicBrainz lookup:</span> <%= musicbrainz_error.delete_prefix("MusicBrainz: ") %></p>
      <% elsif enrichment.present? && enrichment.status != "refreshing" && musicbrainz_claims.empty? %>
        <p class="mt-3 rounded-lg border border-gray-700 bg-gray-900/70 px-3 py-2 text-xs text-gray-300"><span class="font-semibold text-gray-100">MusicBrainz:</span> no reliable recording match found yet. Its year, credits, and tags are unavailable for this song.</p>
      <% end %>
    </section>

    <% if song_contexts.any? %>
      <section class="mt-4 rounded-xl border border-sky-400/25 bg-sky-950/20 p-4">
        <h4 class="font-semibold text-gray-100">Song context</h4>
        <% song_contexts.each do |claim| %>
          <p class="mt-2 text-sm leading-6 text-gray-200"><%= claim.display_value %></p>
          <p class="mt-3 text-xs text-gray-400">
            <%= link_to "Wikipedia source ↗", claim.source_url, target: "_blank", rel: "noopener", class: "font-semibold text-sky-300 hover:text-sky-200" %>
            <span class="text-gray-500">·</span>
            Title / artist song-page candidate · Text from Wikipedia is available under
            <%= link_to "CC BY-SA", "https://creativecommons.org/licenses/by-sa/4.0/", target: "_blank", rel: "noopener", class: "text-sky-300 hover:text-sky-200" %>.
          </p>
        <% end %>
      </section>
    <% end %>

    <% if classifications.any? %>
      <section class="mt-4 rounded-xl border border-gray-700 bg-black/25 p-4">
        <h4 class="font-semibold text-gray-100">Genre & style</h4>
        <p class="mt-1 text-xs text-gray-400">Source taxonomies and community tags—not one universal genre verdict.</p>
        <div class="mt-3 space-y-3">
          <% classifications.each do |_source, source_claims| %>
            <div class="rounded-lg border border-gray-800 bg-gray-950/80 p-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-semibold text-cyan-200"><%= source_claims.first.source_label %></span>
                <% if source_claims.first.discogs? && source_claims.first.source_url.present? %>
                  <%= link_to "Data provided by Discogs.", source_claims.first.source_url, target: "_blank", rel: "noopener", class: "text-xs font-semibold text-orange-300 hover:text-orange-200" %>
                <% elsif source_claims.first.source_url.present? %>
                  <%= link_to "#{source_claims.first.source_label} ↗", source_claims.first.source_url, target: "_blank", rel: "noopener", class: "text-xs font-semibold text-cyan-300 hover:text-cyan-200" %>
                <% end %>
              </div>
              <div class="mt-2 flex flex-wrap gap-2">
                <% source_claims.each do |claim| %>
                  <span title="<%= claim.context %>" class="rounded-full border border-cyan-400/25 bg-cyan-500/10 px-2.5 py-1 text-xs text-cyan-100"><span class="font-semibold"><%= claim.field == "genre" ? "Genre" : "Style" %>:</span> <%= claim.display_value %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if signals.any? %>
      <section class="mt-4 rounded-xl border border-gray-700 bg-black/25 p-4">
        <h4 class="font-semibold text-gray-100">Edition & recording clues</h4>
        <div class="mt-3 flex flex-wrap gap-2">
          <% signals.each do |claim| %>
            <span title="<%= claim.context %>" class="rounded-lg border border-gray-700 bg-gray-900 px-2.5 py-1.5 text-xs text-gray-200"><span class="font-semibold text-gray-100"><%= signal_labels.fetch(claim.field, claim.field.humanize) %>:</span> <%= claim.display_value %></span>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if enrichment&.last_error.present? %>
      <p class="mt-4 rounded-lg border border-yellow-500/30 bg-yellow-950/25 px-3 py-2 text-xs text-yellow-100">Automatic lookup incomplete: <%= enrichment.last_error %></p>
    <% end %>

    <% if claims.any?(&:discogs?) %>
      <p class="mt-4 text-xs text-gray-500">This application uses Discogs’ API but is not affiliated with, sponsored or endorsed by Discogs. ‘Discogs’ is a trademark of Zink Media, LLC.</p>
    <% end %>
  </section>
<% end %>
