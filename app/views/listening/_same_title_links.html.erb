<section class="mt-7 rounded-xl border border-cyan-500/25 bg-cyan-950/10 p-5">
  <% exact_matches = same_title_matches.select { |match| match[:match_kind] == :exact_spotify_id } %>
  <% suspected_matches = same_title_matches.select { |match| match[:match_kind] == :strong_artist_variant } %>
  <% discovery_matches = same_title_matches.select { |match| match[:match_kind] == :different_artist } %>

  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h3 class="text-xl font-bold text-white">Duplicate & same-title signals</h3>
      <p class="mt-1 text-sm text-gray-300">Exact Spotify IDs come first. Artist variants with a different ID are highlighted for review; clearly different artists remain discovery links only.</p>
    </div>
    <span class="shrink-0 text-sm font-semibold text-cyan-300"><%= pluralize(same_title_matches.size, "local track") %></span>
  </div>

  <% if exact_matches.any? %>
    <section class="mt-5">
      <h4 class="font-bold text-emerald-300">Exact Spotify ID</h4>
      <p class="mt-1 text-xs text-gray-400">These are the same Spotify recording. A red warning appears only when that recording occurs more than once in one playlist.</p>
      <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <%= render partial: "same_title_match_card", collection: exact_matches, as: :title_match %>
      </div>
    </section>
  <% end %>

  <% if suspected_matches.any? %>
    <section class="mt-6 border-t border-yellow-500/20 pt-5">
      <h4 class="font-bold text-yellow-300">Strong suspected duplicates</h4>
      <p class="mt-1 text-xs text-gray-400">Same cleaned title plus an artist-name variation, but a different Spotify ID. Review these before treating them as duplicates.</p>
      <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <%= render partial: "same_title_match_card", collection: suspected_matches, as: :title_match %>
      </div>
    </section>
  <% end %>

  <% if discovery_matches.any? %>
    <section class="mt-6 border-t border-green-500/20 pt-5">
      <h4 class="font-bold text-green-300">Different artists, same title</h4>
      <p class="mt-1 text-xs text-gray-400">Useful local discovery links, not duplicate suggestions.</p>
      <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <%= render partial: "same_title_match_card", collection: discovery_matches, as: :title_match %>
      </div>
    </section>
  <% end %>

  <% if same_title_matches.empty? %>
    <p class="mt-4 rounded-lg bg-black/20 p-4 text-sm text-gray-400">No other local crate tracks have this cleaned title yet.</p>
  <% end %>
</section>
