<% artist_footprint = scope == "artist" %>
<% title = artist_footprint ? "Artist footprint" : "Album footprint" %>
<% qualifier = artist_footprint ? "by this artist" : "from this album" %>
<% accent_class = artist_footprint ? "border-blue-500/20 bg-blue-950/20 text-blue-300" : "border-purple-500/20 bg-purple-950/20 text-purple-300" %>

<%= turbo_frame_tag "#{scope}-footprint-#{footprint_key}" do %>
  <div class="mt-4 rounded-xl border <%= accent_class %> p-4">
    <p class="text-3xl font-bold text-white"><%= footprint[:track_count] %></p>
    <p class="text-sm text-gray-300">song<%= "s" unless footprint[:track_count] == 1 %> <%= qualifier %> in your crates</p>
    <p class="mt-2 text-xs text-gray-400"><%= footprint[:playlist_count] %> playlists · <%= footprint[:category_count] %> crate categories</p>

    <% if footprint[:playlists].any? %>
      <div class="mt-5 border-t border-white/10 pt-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Crate categories</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% footprint[:categories].each do |category| %>
            <span class="rounded-full px-2 py-1 text-xs font-medium text-white" style="background-color: <%= category.color.presence || '#4B5563' %>"><%= category.name %></span>
          <% end %>
        </div>

        <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Playlists</p>
        <ul class="mt-2 divide-y divide-white/10 rounded-lg border border-white/10 bg-black/20">
          <% footprint[:playlists].each do |entry| %>
            <% playlist = entry[:playlist] %>
            <li class="p-3">
              <div class="flex items-start gap-3">
                <%= render "crate_cover", playlist: playlist, thumbnail_class: "h-24 w-24" %>
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <%= link_to playlist.title, playlist_path(playlist), class: "min-w-0 font-semibold text-yellow-300 hover:text-yellow-200" %>
                    <span class="shrink-0 text-xs text-gray-400"><%= pluralize(entry[:matching_track_count], "matching song") %></span>
                  </div>
                  <% if entry[:categories].any? %>
                    <div class="mt-2 flex flex-wrap gap-1">
                      <% entry[:categories].each do |category| %>
                        <span class="rounded-full px-2 py-0.5 text-[11px] text-white" style="background-color: <%= category.color.presence || '#4B5563' %>"><%= category.name %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="mt-4 rounded-lg bg-black/20 p-4 text-sm text-gray-400">No local crate placements were found for this <%= artist_footprint ? "artist" : "album" %>.</p>
    <% end %>
  </div>
<% end %>
