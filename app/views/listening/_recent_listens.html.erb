<section class="mt-8 rounded-2xl border border-gray-700 bg-gray-900/80 p-5">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-bold text-white">Recent listens</h2>
    <span class="text-xs text-gray-400">Last 10</span>
  </div>

  <% if recent_tracks.any? %>
    <div class="space-y-2">
      <% recent_tracks.each do |track| %>
        <%= link_to listening_path(
              spotify_id: track[:spotify_id],
              name: track[:name],
              artist: track[:artist],
              album: track[:album],
              image_url: track[:image_url],
              external_url: track[:external_url],
              duration_ms: track[:duration_ms]
            ), class: "flex items-center gap-3 rounded-lg p-2 transition hover:bg-gray-800" do %>
          <% if track[:image_url].present? %>
            <img src="<%= track[:image_url] %>" alt="" class="h-11 w-11 rounded object-cover">
          <% else %>
            <div class="flex h-11 w-11 items-center justify-center rounded bg-gray-800">🎵</div>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-white"><%= track[:name] %></p>
            <p class="truncate text-xs text-gray-400"><%= track[:artist] %></p>
          </div>
          <% if track[:played_at].present? %>
            <span class="whitespace-nowrap text-xs text-gray-500"><%= time_ago_in_words(Time.zone.parse(track[:played_at])) %> ago</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% elsif connected %>
    <p class="py-8 text-center text-sm text-gray-400">Spotify has no recent song history to show yet.</p>
  <% else %>
    <p class="py-8 text-center text-sm text-gray-400">Recent listening will appear here after Spotify is linked.</p>
  <% end %>
</section>
