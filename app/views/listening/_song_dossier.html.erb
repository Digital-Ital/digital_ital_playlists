<details id="song-dossier-details-<%= track.id %>" data-turbo-permanent data-song-dossier class="mt-7 rounded-xl border border-violet-500/30 bg-violet-950/15 p-5">
  <summary class="cursor-pointer list-none marker:hidden">
    <span class="flex items-center justify-between gap-4">
      <span>
        <span class="block text-xl font-bold text-white">Song information & credits</span>
        <span class="mt-1 block text-sm text-violet-200">Release context, credits, source-backed facts, and a lyrics link.</span>
      </span>
      <span class="shrink-0 rounded-full border border-violet-400/30 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-200">Expand cached dossier</span>
    </span>
  </summary>

  <%= turbo_frame_tag "song-dossier-#{track.id}", data: { dossier_src: listening_dossier_path(track_id: track.id) } do %>
    <p class="mt-4 text-sm text-gray-400">Expand to load saved local research. Opening this never calls Spotify, MusicBrainz, or Discogs.</p>
  <% end %>
</details>
