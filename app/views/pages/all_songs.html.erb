<div class="min-h-screen">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-yellow-900 via-red-900 to-green-900 animate-pulse"></div>
      <div class="absolute top-10 left-10 w-32 h-32 bg-yellow-800 rounded-full blur-3xl animate-bounce"></div>
      <div class="absolute top-40 right-20 w-24 h-24 bg-red-900 rounded-full blur-2xl animate-pulse delay-1000"></div>
      <div class="absolute bottom-20 left-1/3 w-28 h-28 bg-green-900 rounded-full blur-3xl animate-bounce delay-500"></div>
    </div>

    <div class="relative z-10 container mx-auto px-6 py-12">
      <div class="text-center mb-8">
        <%= link_to root_path, class: "inline-block", data: { turbo: false } do %>
          <h1 class="text-5xl md:text-7xl font-bold mb-4">
            <span class="bg-gradient-to-r from-yellow-600 via-red-900 to-green-700 bg-clip-text text-transparent drop-shadow-lg">
              Digital Ital Crates
            </span>
          </h1>
        <% end %>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6">
          <span class="bg-gradient-to-r from-orange-700 to-red-900 bg-clip-text text-transparent drop-shadow-lg">
            🎵 Master Song Table 🎵
          </span>
        </h2>

        <div class="flex flex-wrap justify-center gap-3 mb-6">
          <%= link_to root_path, class: "inline-block px-4 sm:px-6 py-2 sm:py-3 bg-yellow-700 text-white rounded-lg hover:bg-yellow-600 transition-colors font-semibold shadow-lg text-sm sm:text-base", data: { turbo: false } do %>
            ← Back to All Playlists
          <% end %>
          <%= link_to whats_new_path, class: "inline-block px-4 sm:px-6 py-2 sm:py-3 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors font-semibold shadow-lg text-sm sm:text-base" do %>
            📈 Curation Feed
          <% end %>
        </div>

        <div class="inline-block bg-black/70 px-3 sm:px-6 py-2 rounded-lg">
          <p class="text-yellow-400 text-sm sm:text-lg font-bold text-center">
            All Songs In One Place — filter by playlist, mix AND/OR, and sort by artist
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-4">
    <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
      <div class="bg-gradient-to-r from-gray-900/80 to-gray-800/80 rounded-xl p-4 sm:p-6 mb-6 sm:mb-8 border border-gray-600/50 backdrop-blur-sm">
        <%= form_with url: all_songs_path, method: :get, local: true do %>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2">
              <label class="block text-gray-200 text-sm font-semibold mb-2">Search songs or artists</label>
              <input
                type="text"
                name="query"
                value="<%= @query %>"
                placeholder="Search track name, artist, album..."
                class="w-full px-4 py-3 bg-black/60 border-2 border-yellow-600/60 rounded-xl text-white placeholder-gray-400 focus:border-yellow-500 focus:outline-none focus:ring-2 focus:ring-yellow-500/50 transition-all duration-200 text-sm"
              />
            </div>
            <div>
              <label class="block text-gray-200 text-sm font-semibold mb-2">Sort by</label>
              <select name="sort" class="w-full px-3 py-3 bg-black/60 border-2 border-gray-600 rounded-xl text-white text-sm">
                <option value="recent" <%= "selected" if @sort == "recent" %>>Most recent add</option>
                <option value="artist" <%= "selected" if @sort == "artist" %>>Artist (A → Z)</option>
                <option value="title" <%= "selected" if @sort == "title" %>>Song title (A → Z)</option>
                <option value="playlist_count" <%= "selected" if @sort == "playlist_count" %>>Most playlists</option>
              </select>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div>
              <label class="block text-gray-200 text-sm font-semibold mb-2">Artist filter</label>
              <input
                type="text"
                name="artist"
                value="<%= @artist %>"
                list="artist-options"
                placeholder="Type to search artists..."
                class="w-full px-4 py-3 bg-black/60 border-2 border-gray-600 rounded-xl text-white placeholder-gray-400 focus:border-yellow-500 focus:outline-none focus:ring-2 focus:ring-yellow-500/50 transition-all duration-200 text-sm"
              />
              <datalist id="artist-options">
                <% @artist_options.each do |artist| %>
                  <option value="<%= artist %>"></option>
                <% end %>
              </datalist>
            </div>
            <div>
              <label class="block text-gray-200 text-sm font-semibold mb-2">Playlist filter mode</label>
              <div class="flex items-center gap-4 bg-black/40 rounded-xl p-3 border border-gray-700/60">
                <label class="flex items-center gap-2 text-sm text-gray-200">
                  <input type="radio" name="filter_mode" value="or" <%= "checked" if @filter_mode == "or" %>>
                  Tracks from ANY selected playlists (OR)
                </label>
                <label class="flex items-center gap-2 text-sm text-gray-200">
                  <input type="radio" name="filter_mode" value="and" <%= "checked" if @filter_mode == "and" %>>
                  Tracks from ALL selected playlists (AND)
                </label>
              </div>
            </div>
            <div class="lg:col-span-2">
              <label class="block text-gray-200 text-sm font-semibold mb-2">Playlists</label>
              <% all_selected = @selected_playlist_ids.empty? %>
              <div class="max-h-72 md:max-h-80 overflow-y-auto bg-black/40 rounded-xl p-3 border border-gray-700/60" data-all-selected="<%= all_selected %>">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <% @playlists.each do |playlist| %>
                    <label class="flex items-center gap-2 text-sm text-gray-200">
                      <input
                        type="checkbox"
                        name="playlist_ids[]"
                        value="<%= playlist.id %>"
                        <%= "checked" if all_selected || @selected_playlist_ids.include?(playlist.id) %>
                      >
                      <span class="line-clamp-1"><%= playlist.title %></span>
                    </label>
                  <% end %>
                </div>
              </div>
              <p class="text-xs text-gray-400 mt-2">
                All playlists are selected by default. Click one to isolate (auto applies), or select multiple and it will apply after a short pause.
              </p>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-end gap-3">
            <%= link_to "Clear filters", all_songs_path, class: "px-4 py-2 rounded-lg bg-gray-800 text-white text-sm font-semibold hover:bg-gray-700" %>
            <button type="submit" class="px-4 py-2 rounded-lg bg-gray-700 text-white text-sm font-semibold hover:bg-gray-600">
              Apply now
            </button>
          </div>
        <% end %>
      </div>

      <%= turbo_frame_tag "songs_results" do %>
        <% if @grouped_tracks.any? %>
          <div class="flex items-center justify-between text-xs text-gray-400 mb-4">
            <div>
              <span class="text-yellow-400 font-semibold"><%= @grouped_tracks.total_count %></span>
              songs found
            </div>
            <div>
              Page <%= @grouped_tracks.current_page %> of <%= @grouped_tracks.total_pages %>
            </div>
          </div>
          <div class="mb-2 text-xs text-gray-600">
            Hover any row for cover art, full playlists, and categories.
          </div>
          <div class="mb-8 overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="text-xs uppercase text-gray-600 border-b border-gray-300/80">
                <tr>
                  <th class="py-2 pr-4 font-semibold">Title</th>
                  <th class="py-2 pr-4 font-semibold">Artist</th>
                  <th class="py-2 pr-4 font-semibold">Album</th>
                  <th class="py-2 pr-4 font-semibold text-center">Playlists</th>
                  <th class="py-2 font-semibold text-right">Link</th>
                </tr>
              </thead>
              <tbody class="text-sm text-gray-900">
                <% @grouped_tracks.each do |group| %>
                  <tr class="group relative border-b border-gray-200 hover:bg-gray-100 transition-colors">
                    <td class="py-2 pr-4 max-w-xs">
                      <div class="inline-block">
                        <a href="<%= group[:track].external_url %>" target="_blank" class="font-semibold text-gray-900 hover:text-yellow-700 line-clamp-1">
                          <%= group[:track].name %>
                        </a>
                        <div class="song-tooltip absolute right-4 top-full mt-2 hidden group-hover:block z-20 pointer-events-auto">
                          <div class="w-80 max-h-72 overflow-y-auto rounded-lg border border-gray-300 bg-white p-3 shadow-xl">
                            <div class="flex gap-3">
                              <% if group[:track].image_url.present? %>
                                <img src="<%= group[:track].image_url %>" alt="<%= group[:track].name %>" class="w-20 h-20 rounded-md flex-shrink-0">
                              <% end %>
                              <div class="min-w-0">
                                <div class="text-sm font-semibold text-gray-900"><%= group[:track].name %></div>
                                <div class="text-xs text-gray-700"><%= group[:track].artist %></div>
                                <div class="text-xs text-gray-500"><%= group[:track].album.presence || "—" %></div>
                                <div class="mt-2 text-xs text-purple-700">
                                  In <%= group[:total_playlists] %> playlists
                                </div>
                                <div class="mt-2 text-xs text-gray-600">
                                  Last added: <%= time_ago_in_words(group[:last_added_at]) %> ago
                                </div>
                                <% if group[:first_added_at].present? %>
                                  <div class="text-xs text-gray-500">
                                    First seen: <%= time_ago_in_words(group[:first_added_at]) %> ago
                                  </div>
                                <% end %>
                              </div>
                            </div>

                            <% if group[:playlists].any? %>
                              <div class="mt-3 text-xs text-gray-700">
                                <div class="text-gray-600 font-semibold mb-1">Playlists</div>
                                <div class="space-y-1">
                                  <% group[:playlists].each do |playlist| %>
                                    <div>
                                      <%= link_to playlist.title, all_songs_path(playlist_ids: [playlist.id]), class: "text-gray-700 hover:text-yellow-700" %>
                                    </div>
                                  <% end %>
                                </div>
                              </div>
                            <% end %>

                            <% if group[:categories].any? %>
                              <div class="mt-3 text-xs text-gray-700">
                                <div class="text-gray-600 font-semibold mb-1">Categories</div>
                                <div class="flex flex-wrap gap-1">
                                  <% group[:categories].each do |category| %>
                                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold"
                                          style="background-color: <%= category.color || '#E5E7EB' %>; color: #111111;">
                                      <%= category.emoji %> <%= category.name %>
                                    </span>
                                  <% end %>
                                </div>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="py-2 pr-4 text-gray-800">
                      <% artist_parts = split_artist_names(group[:track].artist) %>
                      <% if artist_parts.any? %>
                        <% artist_parts.each_with_index do |artist, index| %>
                          <%= link_to artist, all_songs_path(artist: artist),
                                      class: "hover:text-yellow-700 transition-colors" %><%= "," if index < artist_parts.length - 1 %>
                        <% end %>
                      <% else %>
                        <span><%= group[:track].artist %></span>
                      <% end %>
                    </td>
                    <td class="py-2 pr-4 text-gray-600">
                      <span><%= group[:track].album.presence || "—" %></span>
                    </td>
                    <td class="py-2 pr-4 text-center">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">
                        <%= group[:total_playlists] %>
                      </span>
                    </td>
                    <td class="py-2 text-right">
                      <a href="<%= group[:track].external_url %>" target="_blank"
                        class="inline-flex items-center px-2 py-1 rounded-md bg-green-600 text-white text-xs font-bold hover:bg-green-500 transition-colors">
                        ▶️ Spotify
                      </a>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="flex flex-col items-center gap-4">
            <div class="text-center">
              <p class="text-gray-300 text-sm">
                Page <%= @grouped_tracks.current_page %> of <%= @grouped_tracks.total_pages %>
                • <%= @grouped_tracks.total_count %> songs total
              </p>
            </div>
            <div class="flex justify-center">
              <%= paginate @grouped_tracks, params: request.query_parameters %>
            </div>
          </div>
        <% else %>
          <div class="text-center py-20">
            <div class="text-6xl mb-4">🎵</div>
            <h3 class="text-2xl font-bold text-white mb-4">No Songs Match These Filters</h3>
            <p class="text-gray-400 mb-6">
              Try removing some playlists or clearing the search.
            </p>
            <%= link_to "Clear filters", all_songs_path,
                        class: "px-6 py-3 bg-yellow-500 text-black rounded-lg hover:bg-yellow-400 transition-colors font-semibold" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>

<script>
  function setupAllSongsTooltips() {
    document.querySelectorAll('.song-tooltip').forEach((tooltip) => {
      const row = tooltip.closest('tr');
      tooltip.addEventListener('mouseenter', () => {
        document.body.classList.add('tooltip-locked');
        if (row) row.classList.add('tooltip-active');
      });
      tooltip.addEventListener('mouseleave', () => {
        document.body.classList.remove('tooltip-locked');
        if (row) row.classList.remove('tooltip-active');
      });
    });
  }

  function setupAllSongsPlaylistSelection() {
    const playlistContainer = document.querySelector('[data-all-selected]');
    if (!playlistContainer) return;

    const checkboxes = Array.from(playlistContainer.querySelectorAll('input[type="checkbox"]'));
    const allSelected = playlistContainer.dataset.allSelected === 'true';
    const form = playlistContainer.closest('form');
    let submitTimer = null;

    const submitForm = () => {
      if (!form) return;
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
    };

    checkboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', (event) => {
        if (playlistContainer.dataset.allSelected === 'true') {
          checkboxes.forEach((box) => {
            box.checked = false;
          });
          event.target.checked = true;
          playlistContainer.dataset.allSelected = 'false';
          submitForm();
          return;
        }

        clearTimeout(submitTimer);
        submitTimer = setTimeout(submitForm, 500);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupAllSongsTooltips);
  document.addEventListener('turbo:load', setupAllSongsTooltips);
  document.addEventListener('DOMContentLoaded', setupAllSongsPlaylistSelection);
  document.addEventListener('turbo:load', setupAllSongsPlaylistSelection);
</script>

<style>
  body.tooltip-locked tr.group:hover .song-tooltip {
    display: none;
  }

  tr.tooltip-active .song-tooltip {
    display: block;
  }
</style>
