<% content_for :title, "Track research | Digital Ital Crates" %>
<% field_labels = {
  "isrc" => "ISRC",
  "release_date" => "Release date",
  "release_country" => "Release market / country",
  "release_title" => "Release",
  "release_type" => "Release type",
  "release_format" => "Release format",
  "release_position" => "Album position",
  "release_track_count" => "Album track count",
  "content_advisory" => "Content advisory",
  "label" => "Label",
  "recording_note" => "Recording note",
  "recording_location" => "Session / recording location",
  "work_title" => "Linked composition / work",
  "work_type" => "Composition / work type",
  "work_disambiguation" => "Work note",
  "iswc" => "ISWC",
  "catalogue_number" => "Catalogue number",
  "producer" => "Producer",
  "engineer" => "Engineer",
  "mastering_engineer" => "Mastering engineer",
  "mixer" => "Mixer",
  "performer" => "Performer",
  "writer" => "Writer",
  "composer" => "Composer",
  "lyricist" => "Lyricist",
  "arranger" => "Arranger",
  "relationship_fact" => "Relationships / notes",
  "genre" => "Genre",
  "tag" => "Style / tag"
} %>

<div class="container mx-auto max-w-6xl px-4 py-8 sm:px-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-violet-300">Owner-only research controls</p>
      <h1 class="mt-2 text-3xl font-bold text-white"><%= @track.name %></h1>
      <p class="mt-1 text-lg text-gray-300"><%= @track.artist %></p>
      <% if @track.album.present? %><p class="mt-1 text-sm text-gray-500"><%= @track.album %></p><% end %>
    </div>
    <%= link_to "← Open in Listening Desk", listening_path(track_id: @track.id), class: "inline-flex rounded-lg bg-gray-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-700" %>
  </div>

  <section class="mt-7 rounded-2xl border border-violet-500/30 bg-violet-950/20 p-6">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Refresh source evidence</h2>
        <p class="mt-2 max-w-3xl text-sm text-gray-300">This is the only action that contacts Spotify, MusicBrainz, or a verified Discogs release. The public Listening Desk only reads saved claims, and never triggers these calls itself.</p>
        <% if @enrichment.last_refreshed_at.present? %>
          <p class="mt-2 text-xs text-gray-400">Last refresh: <%= @enrichment.last_refreshed_at.in_time_zone("America/Toronto").strftime("%b %-d, %Y at %-l:%M %p %Z") %></p>
        <% end %>
      </div>
      <%= button_to "Refresh source evidence", refresh_admin_track_enrichment_path(@track), method: :post, class: "shrink-0 rounded-lg bg-violet-600 px-5 py-3 font-bold text-white transition hover:bg-violet-500" %>
    </div>

    <% if @enrichment.last_error.present? %>
      <div class="mt-4 rounded-lg border border-yellow-500/30 bg-yellow-950/30 p-3 text-sm text-yellow-100"><%= @enrichment.last_error %></div>
    <% end %>
  </section>

  <section class="mt-6 rounded-2xl border border-orange-500/30 bg-orange-950/15 p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Verified Discogs release</h2>
        <p class="mt-2 max-w-3xl text-sm text-gray-300">Discogs is especially useful for pressings and vintage credits. Find the release first, then paste only its release ID or URL. The API checks the title and any track artist Discogs provides; use your own judgment for the exact version.</p>
      </div>
      <%= link_to "Search Discogs ↗", @discogs_search_url, target: "_blank", rel: "noopener", class: "shrink-0 text-sm font-semibold text-orange-300 hover:text-orange-200" %>
    </div>

    <% unless @discogs_configured %>
      <p class="mt-4 rounded-lg border border-yellow-500/30 bg-yellow-950/30 p-3 text-sm text-yellow-100">Discogs is not configured yet. Add a personal access token as <code>DISCOGS_USER_TOKEN</code> in Heroku before refreshing a selected release.</p>
    <% end %>

    <%= form_with url: admin_track_enrichment_path(@track), method: :patch, class: "mt-5 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="min-w-0 flex-1">
        <%= form.label :discogs_release_id, "Discogs release ID or URL", class: "mb-1 block text-sm font-semibold text-gray-200" %>
        <%= form.text_field :discogs_release_id, value: @enrichment.discogs_release_id, placeholder: "e.g. 1234567 or https://www.discogs.com/release/1234567", class: "w-full rounded-lg border border-gray-600 bg-gray-950 px-4 py-3 text-white placeholder:text-gray-500 focus:border-orange-400 focus:outline-none" %>
      </div>
      <%= form.submit "Save selection", class: "rounded-lg bg-orange-600 px-5 py-3 font-bold text-white transition hover:bg-orange-500" %>
    <% end %>

    <p class="mt-3 text-xs text-gray-400">Changing or clearing the selected release removes its saved Discogs claims. Click “Refresh source evidence” after saving. Ambiguous same-title entries never contribute track-level credits. Discogs facts expire after six hours and are never used as an origin claim.</p>
  </section>

  <section class="mt-6 rounded-2xl border border-gray-700 bg-gray-900/70 p-6">
    <h2 class="text-xl font-bold text-white">Saved evidence</h2>
    <p class="mt-1 text-sm text-gray-400">Each row retains its source and scope. Agreement is only marked when independent sources make the same scoped assertion; different editions are shown side by side instead of being flattened.</p>

    <% if @enrichment.claim_groups.any? %>
      <div class="mt-5 space-y-4">
        <% @enrichment.claim_groups.each do |field, claims| %>
          <% state = @enrichment.evidence_state_for(field, claims) %>
          <section class="rounded-xl border border-gray-700 bg-black/25 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-semibold text-white"><%= field_labels.fetch(field, field.humanize) %></h3>
              <span class="rounded-full border border-gray-600 bg-gray-800 px-2.5 py-1 text-xs font-semibold text-gray-200"><%= state.humanize %></span>
            </div>
            <div class="mt-3 space-y-3">
              <% claims.sort_by { |claim| [ claim.source, claim.display_value.downcase ] }.each do |claim| %>
                <article class="rounded-lg border border-gray-800 bg-gray-950/80 p-3">
                  <p class="font-medium text-gray-100"><%= claim.display_value %></p>
                  <p class="mt-1 text-xs text-gray-400"><%= claim.context %> • <%= claim.confidence_label %></p>
                  <% if claim.source == "discogs" %>
                    <%= link_to "Data provided by Discogs.", claim.source_url, target: "_blank", rel: "noopener", class: "mt-2 inline-block text-xs font-semibold text-orange-300 hover:text-orange-200" %>
                  <% elsif claim.source_url.present? %>
                    <%= link_to "#{claim.source_label} ↗", claim.source_url, target: "_blank", rel: "noopener", class: "mt-2 inline-block text-xs font-semibold text-cyan-300 hover:text-cyan-200" %>
                  <% end %>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 rounded-lg bg-black/25 p-4 text-sm text-gray-400">No saved claims yet. Refresh Spotify and MusicBrainz first, and add a verified Discogs release when useful.</p>
    <% end %>

    <p class="mt-5 text-xs text-gray-500">This application uses Discogs’ API but is not affiliated with, sponsored or endorsed by Discogs. ‘Discogs’ is a trademark of Zink Media, LLC. Discogs data is attributed at the claim and expires after six hours.</p>
  </section>
</div>
